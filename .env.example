# --- Database ---
# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/trackiq

# --- Clerk (authentication) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID for the Pro subscription product
STRIPE_PRICE_ID=price_xxx

# --- App ---
# Public base URL of the deployed app (used in transactional emails)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Transactional email (Resend) ---
# Optional: if unset, welcome emails are skipped (no error).
RESEND_API_KEY=re_xxx
# Verified sender, e.g. "TrackIQ <noreply@your-domain.com>"
EMAIL_FROM=TrackIQ <onboarding@resend.dev>

# --- Clerk webhook (welcome email on user.created) ---
# Svix signing secret from the Clerk Dashboard → Webhooks endpoint.
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Rate limiting (Upstash Redis) ---
# Optional: if unset, rate limiting is a no-op (every request allowed).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# --- Scheduled jobs (Vercel Cron) ---
# Secret that authorizes the follow-up reminder cron. Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>". Generate a long random string.
CRON_SECRET=replace-with-a-long-random-string
